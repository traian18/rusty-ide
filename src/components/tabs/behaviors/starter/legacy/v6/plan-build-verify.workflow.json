{
  "schema_version": 1,
  "id": "plan-build-verify",
  "revision": 10,
  "name": "Plan, build, verify",
  "status": "draft",
  "input_schema": null,
  "metadata": {
    "switch_to": [
      "investigate",
      "diagnose",
      "security-audit"
    ],
    "orchestration": "task-queue-v1"
  },
  "nodes": [
    {
      "id": "input",
      "name": "Request",
      "type": "input",
      "config": {
        "defaults": {
          "attachments": [],
          "context": ""
        }
      },
      "input_bindings": [],
      "output_schema": null,
      "retry": {
        "max_attempts": 1,
        "retry_on": []
      },
      "metadata": {
        "editor": {
          "position": {
            "x": 60,
            "y": 80
          }
        }
      }
    },
    {
      "id": "plan",
      "name": "Plan",
      "type": "agent",
      "config": {
        "instructions": "Plan the request. Write the requirements with acceptance criteria, and ordered tasks that change the code. Every task must change the workspace; things only someone outside it can do (credential rotation, deployments, history rewrites) go in the summary as follow-ups for the user.",
        "tools": {
          "type": "inherit"
        },
        "context_mode": "isolated_child",
        "structured_output": "text",
        "profile": {
          "id": "plan"
        }
      },
      "input_bindings": [
        {
          "target": "request",
          "source": {
            "type": "run_input",
            "pointer": "/request"
          }
        },
        {
          "target": "context",
          "source": {
            "type": "run_input",
            "pointer": "/context"
          }
        }
      ],
      "output_schema": {
        "type": "inline",
        "name": "plan",
        "schema": {
          "type": "string"
        }
      },
      "retry": {
        "max_attempts": 2,
        "retry_on": [
          "backend_rate_limited",
          "backend_timeout",
          "invalid_structured_output"
        ]
      },
      "metadata": {
        "editor": {
          "position": {
            "x": 360,
            "y": 80
          }
        }
      }
    },
    {
      "id": "build",
      "name": "Build",
      "type": "agent",
      "config": {
        "instructions": "Implement the plan in workflow_input.plan in the workspace. Read the code, make the changes, and run the project's checks when you can. If a command fails, read its output and try another way; do not stop before the changes are made. When Verify or a final review sends the work back, use every failed or unverified criterion and its evidence as a repair checklist. Inspect the named files, implement the missing behavior, then rerun focused checks and verify each criterion against the actual workspace. Finish with a short summary of what you changed.",
        "tools": {
          "type": "inherit"
        },
        "context_mode": "isolated_child",
        "structured_output": "text",
        "profile": {
          "id": "build"
        }
      },
      "input_bindings": [
        {
          "target": "request",
          "source": {
            "type": "run_input",
            "pointer": "/request"
          }
        },
        {
          "target": "context",
          "source": {
            "type": "run_input",
            "pointer": "/context"
          }
        },
        {
          "target": "plan",
          "source": {
            "type": "node_output",
            "node_id": "plan",
            "pointer": ""
          }
        }
      ],
      "output_schema": {
        "type": "inline",
        "name": "build",
        "schema": {
          "type": "string"
        }
      },
      "retry": {
        "max_attempts": 3,
        "retry_on": [
          "backend_rate_limited",
          "backend_timeout",
          "verification_failed"
        ]
      },
      "metadata": {
        "editor": {
          "position": {
            "x": 660,
            "y": 80
          }
        }
      }
    },
    {
      "id": "verify",
      "name": "Verify",
      "type": "agent",
      "config": {
        "instructions": "Check that the changes in the workspace implement workflow_input.request and the plan, and that they were done properly. Run the project's checks when you can. Verdict: pass if it is done properly, otherwise fail followed by what is wrong.",
        "tools": {
          "type": "inherit"
        },
        "context_mode": "isolated_child",
        "structured_output": "host_validated",
        "profile": {
          "id": "verify"
        }
      },
      "input_bindings": [
        {
          "target": "request",
          "source": {
            "type": "run_input",
            "pointer": "/request"
          }
        },
        {
          "target": "context",
          "source": {
            "type": "run_input",
            "pointer": "/context"
          }
        },
        {
          "target": "plan",
          "source": {
            "type": "node_output",
            "node_id": "plan",
            "pointer": ""
          }
        },
        {
          "target": "build",
          "source": {
            "type": "node_output",
            "node_id": "build",
            "pointer": ""
          }
        }
      ],
      "output_schema": {
        "type": "inline",
        "name": "verify",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verdict",
            "criteria",
            "summary"
          ],
          "properties": {
            "verdict": {
              "type": "string",
              "minLength": 1
            },
            "criteria": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "status",
                  "evidence"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "pass",
                      "fail",
                      "unverified"
                    ]
                  },
                  "evidence": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "summary": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "retry": {
        "max_attempts": 2,
        "retry_on": [
          "backend_rate_limited",
          "backend_timeout",
          "invalid_structured_output"
        ]
      },
      "metadata": {
        "editor": {
          "position": {
            "x": 960,
            "y": 80
          }
        }
      }
    },
    {
      "id": "gate",
      "name": "Acceptance",
      "type": "verify",
      "config": {
        "checks": [
          {
            "type": "required_status",
            "pointer": "/check/verdict",
            "equals": "pass"
          }
        ],
        "retry_target": "build"
      },
      "input_bindings": [
        {
          "target": "check",
          "source": {
            "type": "node_output",
            "node_id": "verify",
            "pointer": ""
          }
        },
        {
          "target": "plan",
          "source": {
            "type": "node_output",
            "node_id": "plan",
            "pointer": ""
          }
        }
      ],
      "output_schema": null,
      "retry": {
        "max_attempts": 1,
        "retry_on": []
      },
      "metadata": {
        "editor": {
          "position": {
            "x": 1260,
            "y": 80
          }
        }
      }
    },
    {
      "id": "output",
      "name": "Result",
      "type": "output",
      "config": {
        "source": {
          "type": "node_output",
          "node_id": "verify",
          "pointer": "/summary"
        },
        "strict": false
      },
      "input_bindings": [],
      "output_schema": null,
      "retry": {
        "max_attempts": 1,
        "retry_on": []
      },
      "metadata": {
        "editor": {
          "position": {
            "x": 1560,
            "y": 80
          }
        }
      }
    }
  ],
  "edges": [
    {
      "id": "input-plan",
      "source": "input",
      "target": "plan",
      "condition": "on_success"
    },
    {
      "id": "plan-build",
      "source": "plan",
      "target": "build",
      "condition": "on_success"
    },
    {
      "id": "build-verify",
      "source": "build",
      "target": "verify",
      "condition": "on_success"
    },
    {
      "id": "verify-gate",
      "source": "verify",
      "target": "gate",
      "condition": "on_success"
    },
    {
      "id": "gate-output",
      "source": "gate",
      "target": "output",
      "condition": "on_success"
    }
  ],
  "policies": {
    "max_total_attempts": 40
  },
  "output_contract": {
    "schema": {
      "type": "inline",
      "name": "result",
      "schema": {
        "type": "string"
      }
    },
    "source": {
      "type": "node_output",
      "node_id": "verify",
      "pointer": "/summary"
    },
    "strict": false
  },
  "description": "Plan the change, implement it in the workspace, then verify it was done properly. A failed verification sends the work back with the findings."
}
