{
  "schema_version": 1,
  "id": "plan-build-verify",
  "revision": 1,
  "name": "Plan, build, verify",
  "description": "Plan the change, implement it, then verify the result: Request → Plan → Build → Verify → Result. Plan is read-only; Build edits the workspace; Verify checks the report and that every file it claims exists.",
  "status": "draft",
  "input_schema": {
    "type": "inline",
    "name": "orchestration_input",
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request"],
      "properties": {
        "request": { "type": "string", "minLength": 1 },
        "attachments": { "type": "array", "default": [] }
      }
    }
  },
  "output_contract": {
    "schema": {
      "type": "inline",
      "name": "execution_report",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "status", "artifacts", "claimsToVerify"],
        "properties": {
          "summary": { "type": "string" },
          "status": { "enum": ["completed", "blocked", "failed"] },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "reference"],
              "properties": {
                "kind": { "type": "string" },
                "reference": { "type": "string" }
              }
            }
          },
          "claimsToVerify": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "source": { "type": "node_output", "node_id": "build", "pointer": "" },
    "strict": true
  },
  "nodes": [
    {
      "id": "input",
      "name": "Request",
      "type": "input",
      "config": { "defaults": { "attachments": [] } },
      "input_bindings": [],
      "output_schema": null,
      "retry": { "max_attempts": 1, "retry_on": [] },
      "metadata": { "editor": { "position": { "x": 60, "y": 80 } } }
    },
    {
      "id": "plan",
      "name": "Plan",
      "type": "agent",
      "config": {
        "instructions": "Plan the change described in the request so the next step can implement it without re-discovering anything. Explore the relevant code first: locate it with search_codebase or list_files, then read what the plan depends on. Then return the plan as JSON: `summary` (one or two sentences), `steps` (ordered; each with a `title` and a `detail` naming the files and functions involved), `filesToChange` (workspace-relative paths), and `risks` (what could break or must be checked).",
        "tools": { "type": "inherit" },
        "context_mode": "isolated_child",
        "model": null,
        "structured_output": "host_validated",
        "profile": { "id": "plan" }
      },
      "input_bindings": [
        { "target": "request", "source": { "type": "run_input", "pointer": "/request" } }
      ],
      "output_schema": {
        "type": "inline",
        "name": "plan_output",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "steps", "filesToChange", "risks"],
          "properties": {
            "summary": { "type": "string" },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "detail"],
                "properties": {
                  "title": { "type": "string" },
                  "detail": { "type": "string" }
                }
              }
            },
            "filesToChange": { "type": "array", "items": { "type": "string" } },
            "risks": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "retry": {
        "max_attempts": 2,
        "retry_on": ["backend_rate_limited", "backend_timeout", "tool_timeout", "invalid_structured_output"]
      },
      "timeout_ms": 600000,
      "metadata": { "editor": { "position": { "x": 380, "y": 80 } } }
    },
    {
      "id": "build",
      "name": "Build",
      "type": "agent",
      "config": {
        "instructions": "Implement the plan for the request, following its steps in order. If the code contradicts the plan, make the smallest sensible adaptation and record it in `summary`. When you finish editing, check your work: run the project's tests, type-check, or build if they exist, otherwise read the changed files back. Then return the execution report as JSON: `status` is `completed` only when every plan step is done and your checks passed, `blocked` when you need something you cannot obtain, and `failed` when the attempt did not work. List every file you created or changed in `artifacts` as {\"kind\": \"file\", \"reference\": \"<workspace-relative path>\"}, and put anything the verification step should double-check in `claimsToVerify`.",
        "tools": { "type": "inherit" },
        "context_mode": "isolated_child",
        "model": null,
        "structured_output": "host_validated",
        "profile": { "id": "build" }
      },
      "input_bindings": [
        { "target": "request", "source": { "type": "run_input", "pointer": "/request" } },
        { "target": "plan", "source": { "type": "node_output", "node_id": "plan", "pointer": "" } }
      ],
      "output_schema": {
        "type": "inline",
        "name": "execution_report",
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "status", "artifacts", "claimsToVerify"],
          "properties": {
            "summary": { "type": "string" },
            "status": { "enum": ["completed", "blocked", "failed"] },
            "artifacts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "reference"],
                "properties": {
                  "kind": { "type": "string" },
                  "reference": { "type": "string" }
                }
              }
            },
            "claimsToVerify": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "retry": {
        "max_attempts": 2,
        "retry_on": ["backend_rate_limited", "backend_timeout", "tool_timeout", "invalid_structured_output", "verification_failed"]
      },
      "timeout_ms": 1800000,
      "metadata": { "editor": { "position": { "x": 700, "y": 80 } } }
    },
    {
      "id": "verify",
      "name": "Verify",
      "type": "verify",
      "config": {
        "checks": [
          { "type": "schema" },
          { "type": "required_status", "pointer": "/report/status", "equals": "completed" },
          { "type": "artifact_exists", "pointer": "/plan/steps" },
          { "type": "artifacts_resolvable", "pointer": "/report/artifacts" }
        ],
        "retry_target": "build"
      },
      "input_bindings": [
        { "target": "plan", "source": { "type": "node_output", "node_id": "plan", "pointer": "" } },
        { "target": "report", "source": { "type": "node_output", "node_id": "build", "pointer": "" } }
      ],
      "output_schema": null,
      "retry": { "max_attempts": 1, "retry_on": [] },
      "timeout_ms": 120000,
      "metadata": { "editor": { "position": { "x": 1020, "y": 80 } } }
    },
    {
      "id": "output",
      "name": "Result",
      "type": "output",
      "config": {
        "source": { "type": "node_output", "node_id": "build", "pointer": "" },
        "strict": true
      },
      "input_bindings": [],
      "output_schema": null,
      "retry": { "max_attempts": 1, "retry_on": [] },
      "metadata": { "editor": { "position": { "x": 1340, "y": 80 } } }
    }
  ],
  "edges": [
    { "id": "input-plan", "source": "input", "target": "plan", "condition": "on_success" },
    { "id": "plan-build", "source": "plan", "target": "build", "condition": "on_success" },
    { "id": "build-verify", "source": "build", "target": "verify", "condition": "on_success" },
    { "id": "verify-output", "source": "verify", "target": "output", "condition": "on_success" }
  ],
  "policies": {
    "max_steps": 16,
    "max_total_attempts": 24,
    "max_elapsed_ms": 7200000,
    "max_model_requests": 400,
    "max_tool_calls": 800,
    "max_tokens": 4000000,
    "max_cost_usd": 10
  },
  "metadata": {}
}
